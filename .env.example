# ---------------------------------------------------------------------------
# Calce - variables de entorno
# Copiar a `.env` en la raiz del monorepo y completar los valores.
# La API valida este archivo al arrancar y falla si algo requerido falta.
# ---------------------------------------------------------------------------

# --- Base de datos --------------------------------------------------------
# Cadena de conexion de Neon (PostgreSQL). Requiere la extension pgvector.
# Formato: postgresql://usuario:password@host/base?sslmode=require
DATABASE_URL=

# Opcional, solo para desarrollo local con `docker-compose.yml`. Apunta al
# proxy WebSocket de Neon que hace de puente contra un PostgreSQL comun.
# Contra Neon se deja vacia.
NEON_WS_PROXY=

# --- API ------------------------------------------------------------------
# Puerto HTTP del backend NestJS.
PORT=3000
# development | test | production
NODE_ENV=development
# Origenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# Secretos de firma JWT. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# --- IA -------------------------------------------------------------------
# Proveedor activo del Vercel AI SDK: google | openai
AI_PROVIDER=google
# Credencial del proveedor elegido (solo hace falta la del proveedor activo).
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
# Modelo de generacion de texto (ej. gemini-2.5-flash o gpt-4.1-mini).
AI_MODEL=
# Modelo de embeddings. Debe producir vectores de 1536 dimensiones para
# coincidir con la columna `products.embedding` definida en @calce/db.
AI_EMBEDDING_MODEL=

# --- Frontend -------------------------------------------------------------
# URL base de la API que consume el cliente web.
VITE_API_URL=http://localhost:3000/api
