{
  "name": "@calce/db",
  "version": "0.1.0",
  "private": true,
  "description": "Esquema Drizzle, cliente de base de datos y migraciones de Calce",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@calce/types": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/ws": "8.18.1",
    "argon2": "0.45.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
